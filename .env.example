APP_NAME=Celik
# Docker Compose project name, used to prefix container/volume names
# (celik-laravel.test-1, celik-mysql-1, ...) instead of defaulting to the
# checkout directory's name. Must be lowercase.
COMPOSE_PROJECT_NAME=celik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Host ports used by compose.yaml. Change one if it is already in use; if you
# change APP_PORT, change the port in APP_URL too.
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_N8N_PORT=5678

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The MySQL container from compose.yaml. These create the local database, so
# the password is only a local default.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=celik
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Grading runs on the queue service. Keep this as database: with sync, students
# wait for the AI and an outage becomes a server error.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Powers homework grading (HomeworkDiagnosisService) - a free key is available
# at https://aistudio.google.com/apikey. Without it, PDF submissions are marked
# as failed and photo or typed answers error (the quiz path needs no AI).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Emails the teacher through n8n when a graded submission has answers to
# review (NotifySubmissionGraded). Leave the URL empty to turn it off. The
# secret must match the "Header Auth" credential on the n8n webhook.
# From the Sail containers: http://n8n:5678/webhook/submission-graded
N8N_SUBMISSION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
